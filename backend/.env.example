# ===================================================================
# CampusX Backend Environment Configuration Example
# ===================================================================

# Application Profile ('dev' for local H2, 'prod' for PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render / Hosting platforms automatically supply PORT)
PORT=8080

# PostgreSQL Database Configuration (Required when SPRING_PROFILES_ACTIVE=prod)
DB_URL=jdbc:postgresql://localhost:5432/campusx_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT Signing Secret (Minimum 256-bit secure secret key)
JWT_SECRET=YourSuperSecure256BitSecretKeyForProductionJwtSigningMustBeLongEnough!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of origins or * for all)
CORS_ALLOWED_ORIGINS=https://campusx-frontend.onrender.com,http://localhost:5173

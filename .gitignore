# ------------------------------------------------------------------------------
target/
**/target/
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven Wrapper & runtime metadata
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar


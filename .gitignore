# ------------------------------------------------------------------------------
# 1. Secrets, Credentials & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Certificate and Private Key files
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.cer
*.crt
*.der
*.keystore
*.jks

# Secret & Local configuration files
secrets/
credentials/
*-secrets.*
application-local.properties
application-local.yml
application-secrets.properties
application-secrets.yml

# Local automation / scratch test scripts containing local credentials
*.ps1
!run_app.ps1
*.sh
!run_app.sh

# ------------------------------------------------------------------------------
